<Project>
    <!-- ASSEMBLY BASIC PROPERTIES -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <!-- ASSEMBLY ADDITIONAL PROPERTIES -->
    <PropertyGroup>
        <AssemblyName>fhfps60</AssemblyName>
        <AssemblyTitle>60 FPS</AssemblyTitle>
        <Product>60 FPS</Product>
    </PropertyGroup>

    <!-- SOURCE LAYOUT SUPPORT -->
    <PropertyGroup>
        <!-- Probe upstream layout post-fahrenheit#134 ("rearrange source tree") first, then pre-#134. -->
        <FahrenheitRootDir Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\core\Fahrenheit.csproj')">$(MSBuildThisFileDirectory)..\..\</FahrenheitRootDir>
        <FahrenheitRootDir Condition="'$(FahrenheitRootDir)' == '' and Exists('$(MSBuildThisFileDirectory).workspace\fahrenheit\src\core\Fahrenheit.csproj')">$(MSBuildThisFileDirectory).workspace\fahrenheit\</FahrenheitRootDir>

        <FahrenheitCoreProjectRelative Condition="'$(FahrenheitRootDir)' != '' and Exists('$(FahrenheitRootDir)src\core\Fahrenheit.csproj')">src\core\Fahrenheit.csproj</FahrenheitCoreProjectRelative>
        <FahrenheitCoreProjectRelative Condition="'$(FahrenheitCoreProjectRelative)' == ''">core\fh\Fahrenheit.csproj</FahrenheitCoreProjectRelative>
    </PropertyGroup>

    <!-- SDK REFERENCES -->
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <!-- PROJECT REFERENCES -->
    <ItemGroup>
        <ProjectReference Include="$(FahrenheitRootDir)$(FahrenheitCoreProjectRelative)">
            <Private>false</Private>
            <ExcludeAssets>runtime;native</ExcludeAssets>
            <GlobalPropertiesToRemove>BaseOutputPath;BaseIntermediateOutputPath</GlobalPropertiesToRemove>
        </ProjectReference>
    </ItemGroup>

    <!-- REPO TOOLING EXCLUDES -->
    <ItemGroup>
        <Compile Remove=".workspace/**" />
        <Compile Remove="tools/**" />
    </ItemGroup>

    <!-- ASSETS: MANIFEST -->
    <ItemGroup>
        <None Include="$(AssemblyName).manifest.json" CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
